---
// Logo, the four sections, the contact button and the light/dark switch.
// On phones the links fold into a menu.
const NAV = [
  { href: '/#work', label: 'Work' },
  { href: '/#research', label: 'Research' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="Sangamlung, home">
      <span class="logo-mark" aria-hidden="true"></span><span class="logo-text">Sangamlung</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">menu</button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {NAV.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <a class="button nav-cta" href="/#contact">Start a project</a>
      <button class="theme-toggle" type="button" aria-label="Switch to light mode" title="Light or dark">
        <span aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const isDark = () => root.dataset.theme
    ? root.dataset.theme === 'dark'
    : !matchMedia('(prefers-color-scheme: light)').matches;
  const label = () => toggle.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  toggle.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    label();
    document.dispatchEvent(new CustomEvent('themechange'));
  });

  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = document.getElementById('site-nav')!;
  const setOpen = (open: boolean) => {
    menu.setAttribute('aria-expanded', String(open));
    menu.textContent = open ? 'close' : 'menu';
    nav.classList.toggle('open', open);
  };
  menu.addEventListener('click', () => setOpen(menu.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', e => { if ((e.target as Element).closest('a')) setOpen(false); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font: 400 1.125rem/1 var(--mono); }
  .logo-mark { width: 0.75rem; height: 0.75rem; background: var(--morung-red); box-shadow: 0.3rem 0.3rem 0 var(--morung-yellow); }
  .nav { display: flex; align-items: center; gap: 2rem; }
  .nav ul { display: flex; gap: 1.75rem; list-style: none; margin: 0; padding: 0; }
  .nav ul a { text-decoration: none; font-size: 1.0625rem; padding-block: 0.25rem; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 200ms ease; }
  .nav ul a:hover { background-size: 100% 1px; }
  .nav-cta { min-height: 2.5rem; padding: 0.55rem 1.1rem; font-size: 1rem; background: transparent; color: var(--accent); border-color: var(--accent); }
  .nav-cta:hover { background: var(--button); color: var(--on-button); border-color: var(--button); }
  .theme-toggle {
    width: 3rem; height: 1.6rem; border-radius: 999px; border: 1px solid var(--line);
    background: var(--bg-raise); padding: 0; cursor: pointer; position: relative;
  }
  .theme-toggle span {
    position: absolute; top: 50%; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%;
    transform: translate(1.45rem, -50%); background: var(--ink); transition: transform 200ms ease;
    box-shadow: inset -0.3rem -0.1rem 0 0 var(--bg-raise);
  }
  :global(:root[data-theme="light"]) .theme-toggle span { transform: translate(0, -50%); box-shadow: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .theme-toggle span { transform: translate(0, -50%); box-shadow: none; }
  }
  .menu-toggle { display: none; }

  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-block; background: none; border: 0; color: var(--ink); cursor: pointer;
      font: 400 1rem/1 var(--mono); padding: 0.75rem 0;
    }
    .menu-toggle::before { content: '// '; color: var(--muted); }
    .nav {
      position: fixed; inset: 4.5rem 0 auto 0; flex-direction: column; align-items: flex-start; gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem; background: var(--bg); border-bottom: 1px solid var(--line);
      display: none;
    }
    .nav.open { display: flex; }
    .nav ul { flex-direction: column; gap: 1rem; }
    .nav ul a { font-size: 1.75rem; }
  }
</style>
