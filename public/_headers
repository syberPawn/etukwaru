/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# The truck game compiles its physics engine (WebAssembly), which the policy
# above forbids. Its own page sets a policy that allows it, in a <meta> tag;
# the header policy is removed here so the two don't combine.
/truck/*
  ! Content-Security-Policy

# Built files carry a content hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Small files at the root that may change: a day, then revalidate.
/theme.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/morung-tile.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Recordings, posters and stills carry a content fingerprint in their name
# (tools/fingerprint-media.cjs), so a file never changes at its address.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# The truck's pictures, videos and physics engine change rarely: keep them for
# a day, and serve the cached copy while checking for a newer one for a week.
/truck/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/truck/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
